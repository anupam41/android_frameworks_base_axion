<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_calendar_pill_root"
    android:layout_width="@dimen/kg_widget_pill_width"
    android:layout_height="@dimen/kg_widget_pill_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp"
    android:background="@drawable/bg_widget_pill"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/calendar_icon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_calendar_event"
        android:tint="?android:attr/textColorPrimary"
        android:contentDescription="@string/widget_calendar" />

    <TextView
        android:id="@+id/calendar_event_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="No upcoming events"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorPrimary"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>