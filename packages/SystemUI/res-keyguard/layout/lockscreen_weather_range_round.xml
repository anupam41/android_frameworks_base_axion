<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/kg_widget_circle_size"
    android:layout_height="@dimen/kg_widget_circle_size"
    android:layout_marginHorizontal="@dimen/kg_widgets_margin_horizontal"
    android:background="@drawable/bg_widget_circle"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="2dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            
            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_up"
                android:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/temp_high"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40°"
                android:textSize="10sp"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingStart="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_arrow_down"
                android:tint="?android:attr/textColorPrimary" />

            <TextView
                android:id="@+id/temp_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30°"
                android:textSize="10sp"
                android:textColor="?android:attr/textColorPrimary"
                android:paddingStart="2dp"/>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>