<?xml version="1.0" encoding="utf-8"?>
<com.android.systemui.lockscreen.LockScreenWidgets
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/lockscreen_widgets"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:gravity="center"
    android:orientation="vertical">

    <GridLayout
        android:id="@+id/main_widgets_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kg_widget_margin_vertical"
        android:layout_marginBottom="@dimen/kg_widget_margin_bottom"
        android:columnCount="4"
        android:gravity="center_horizontal"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="false"
        android:clipChildren="false"
        android:clipToPadding="false" />
</com.android.systemui.lockscreen.LockScreenWidgets>